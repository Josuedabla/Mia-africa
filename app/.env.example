# Supabase Configuration (public anon key - safe in client bundle, RLS
# enforces access control, not this key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Chariow Payment Configuration (public checkout URL only - the secret
# API key lives server-side, see supabase/functions/chariow-webhook and
# scripts/set-edge-function-secrets.sh)
VITE_CHARIOW_CHECKOUT_URL=https://miaweb.mychariow.market/miaadsking/checkout
VITE_CHARIOW_MIN_AMOUNT=600

# App Configuration
VITE_APP_NAME=MIA Marketplace
VITE_APP_URL=https://mia-marketplace.app
# Informational only - the value actually enforced on every sale lives in
# the platform_settings table (supabase/migrations/20260718000006_functions.sql),
# editable by an admin without a redeploy. Keep this in sync for display purposes only.
VITE_COMMISSION_RATE=8
VITE_SUPPORTED_COUNTRIES=TG,BJ,CM,GH,SN,CI,ML,BF,NE,TD,GA,CG,CD,KE,TZ,UG,RW,ZA,NG,EG,MA,DZ,TN,LY
VITE_SUPPORTED_LANGUAGES=fr,en,sw,ar,pt

# PWA Configuration
VITE_PWA_ENABLED=true

# Feature Flags
VITE_FEATURE_MIA_COACH=true
VITE_FEATURE_MOBILE_MONEY=true
VITE_FEATURE_DELIVERY_TRACKING=false
